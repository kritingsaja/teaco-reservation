# Production: PostgreSQL/Neon connection string, never put this in dist/.
DATABASE_URL=
# Used only to create the FIRST admin in an empty production database.
# Minimum 10 characters; no default password is supplied.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Cashier adapter URLs. Leave blank until its API is available.
POS_MENU_URL=
POS_DRAFT_URL=
POS_API_TOKEN=
# Local only: without DATABASE_URL, npm run dev creates .data/teaco.sqlite.
PORT=4173
