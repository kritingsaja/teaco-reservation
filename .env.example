# Production: supplied by Turso Cloud Marketplace; never put these in dist/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Used only to create the FIRST admin in an empty production database.
# Minimum 10 characters; no default password is supplied.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Cashier adapter URLs. Leave blank until its API is available.
POS_MENU_URL=
POS_DRAFT_URL=
POS_API_TOKEN=
# Local only: without Turso credentials, npm run dev keeps .data/teaco.sqlite.
PORT=4173
